---
interface Props {
  variant?: "primary" | "secondary";
  /** Omit to render a real <button> instead of a link. */
  href?: string;
  text: string;
  id?: string;
  class?: string;
}

const {
  variant = "primary",
  href,
  text,
  id,
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-md border px-4 py-2 font-sans text-[0.9375rem] leading-6 font-medium no-underline transition-colors";

const variants = {
  primary: "border-transparent bg-accent text-on-accent hover:bg-accent-hover",
  secondary:
    "border-rule-strong bg-surface text-ink hover:border-rule-strong hover:bg-hover",
};

const classes = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a class={classes} {href} {id}>
      {text}
    </a>
  ) : (
    <button type="button" class={classes} {id}>
      {text}
    </button>
  )
}
