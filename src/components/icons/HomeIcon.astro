  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <path d="M3.5 10.5 12 3.5l8.5 7"></path>
  <path d="M5.5 9.7V20h13V9.7"></path>
  <path d="M9.75 20v-5.5h4.5V20"></path>
</svg>
