---
import BaseLayout from "@layouts/BaseLayout.astro";
import LinkButton from "@components/LinkButton.astro";
import ImageGrid from "@components/ImageGrid.astro";
import DecisionList from "@components/DecisionList.astro";
import type { JourneyLayoutData } from "src/types";

interface Props extends JourneyLayoutData {}

const { title, caseNumber, paragraphs, nextHref, decisions, images } =
  Astro.props;

const hasDecisions = Boolean(decisions?.length);
---

<BaseLayout {title}>
  <article class="space-y-8 lg:space-y-10">
    <header class="space-y-2">
      {
        caseNumber && (
          <p class="text-accent font-sans text-[0.6875rem] font-semibold tracking-[0.14em] uppercase">
            Case {caseNumber}
          </p>
        )
      }
      <h1
        class="font-serif text-[1.625rem] leading-tight font-semibold tracking-[-0.01em] text-balance lg:text-[2rem]"
      >
        {title}
      </h1>
    </header>

    <slot name="before-paragraphs" />

    {
      paragraphs && paragraphs.length > 0 && (
        <div class="narrative space-y-5 lg:space-y-6">
          {paragraphs.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
      )
    }

    <slot name="before-images" />

    {images && <ImageGrid images={images} />}

    <slot name="before-decisions" />

    {hasDecisions && <DecisionList decisions={decisions!} />}

    <slot name="before-buttons" />

    <nav
      aria-label="Case navigation"
      class="border-rule flex items-center justify-between gap-4 border-t pt-6"
    >
      <LinkButton id="layout-back" variant="secondary" text="Back" />

      {nextHref && <LinkButton variant="primary" text="Next" href={nextHref} />}
    </nav>

    <slot name="after-buttons" />
  </article>
</BaseLayout>

<script is:inline>
  document
    .getElementById("layout-back")
    .addEventListener("click", () => window.history.back());
</script>
